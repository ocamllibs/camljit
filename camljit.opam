# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1"
synopsis: "In-memory assembler and loader for the OCaml native compiler"
description: """
camljit compiles OCaml code with compiler-libs and loads it in the
running native process without external assembler, linker or dynamic
loader: the assembly code produced by the backend of the compiler is
encoded in memory (amd64 and arm64), relocated, registered in the runtime
and run. It is used by ocip and metapp.
"""
maintainer: ["Thierry Martinez <thierry.martinez@inria.fr>"]
authors: ["Thierry Martinez <thierry.martinez@inria.fr>"]
license: "BSD-2-Clause"
homepage: "https://github.com/thierry-martinez/camljit"
doc: "https://github.com/thierry-martinez/camljit"
bug-reports: "https://github.com/thierry-martinez/camljit/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.3" & < "5.7"}
  "conf-binutils" {with-test & os = "linux"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thierry-martinez/camljit.git"
# The loader maps memory with mmap and resolves symbols with dlsym.
available: os != "win32"
